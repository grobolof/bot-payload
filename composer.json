{
  "name": "grobolof/bot-payload",
  "type": "library",
  "description": "Hydration of Telegram and VK bot webhooks and formatting of outgoing messages and keyboards",
  "keywords": [
    "telegram",
    "vk",
    "bot",
    "payload",
    "webhook",
    "mapper",
    "formatter"
  ],
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "symfony/property-access": "^6.4 || ^7.4 || ^8.0",
    "symfony/property-info": "^6.4 || ^7.4 || ^8.0",
    "symfony/serializer": "^6.4 || ^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "BotPayload\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BotPayload\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
